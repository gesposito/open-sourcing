{
  "name": "open-sourcing",
  "version": "0.1.0",
  "description": "Guidelines and tooling for open-sourcing projects safely",
  "type": "module",
  "private": true,
  "bin": {
    "oss": "./src/cli.ts"
  },
  "scripts": {
    "oss": "bun src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint:actions": "zizmor --persona=regular .",
    "check": "bun run typecheck && bun test && bun src/cli.ts audit ."
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
