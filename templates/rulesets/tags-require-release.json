{
  "name": "tag-requires-release",
  "target": "tag",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~ALL"],
      "exclude": []
    }
  },
  "rules": [
    { "type": "non_fast_forward" },
    {
      "type": "required_deployments",
      "parameters": { "required_deployment_environments": ["release"] }
    }
  ],
  "bypass_actors": []
}
